<form class="ft-zoneconfig">

  <section class="ft-zoneconfig-section">

    <div class="ft-zoneconfig-header">
      <h2>Main</h2>
    </div>

    <div class="ft-zoneconfig-section-content">

      <div class="ft-zoneconfig-row">

        <div class="ft-zoneconfig-field-inline">
          <label>Name</label>
          <input type="text" name="name" value="{{zone.name}}">
        </div>

        <div class="ft-zoneconfig-field-inline ft-zoneconfig-color">
          <label>Zone Color</label>
          <input type="color" name="color" value="{{zone.color}}">
        </div>

      </div>

      <div class="ft-zoneconfig-field">
        <label>Description</label>
        <textarea name="description" rows="3">{{zone.description}}</textarea>
      </div>

    </div>

  </section>

  <section class="ft-zoneconfig-section">

    <div class="ft-zoneconfig-header">
      <h2>Zone Stress</h2>

      <span class="ft-zoneconfig-header-toggle">
        Enabled
        <input type="checkbox" name="enableStress" data-target="ft-zoneconfig-stress-section" {{checked zone.enableStress}}>
      </span>
    </div>

    <div class="ft-zoneconfig-section-content" id="ft-zoneconfig-stress-section">

      <div class="ft-zoneconfig-field-inline">
        <label>Stress Boxes</label>
        <input type="number" name="stressBoxes" value="{{zone.stressBoxes}}" min="1" max="20" style="width: 50px;">
      </div>

    </div>

  </section>

  <section class="ft-zoneconfig-section">

    <div class="ft-zoneconfig-header">
      <h2>Aspects</h2>

      <span class="ft-zoneconfig-header-toggle">
        Enabled
        
      <input type="checkbox" name="enableAspects" data-target="ft-zoneconfig-aspects-section" {{checked zone.enableAspects}}>
 
      </span>
    </div>

    <div class="ft-zoneconfig-section-content" id="ft-zoneconfig-aspects-section">

      <div class="ft-zoneconfig-field">
        <label>Aspects</label>
        <textarea name="aspects" rows="6">{{aspectsText}}</textarea>
      </div>

    </div>

  </section>

  <section class="ft-zoneconfig-section">

    <div class="ft-zoneconfig-header">
      <h2>Consequences</h2>

      <span class="ft-zoneconfig-header-toggle">
        Enabled
        <input type="checkbox" name="enableConsequences" data-target="ft-zoneconfig-consequences-section" {{checked zone.enableConsequences}}>
      </span>
    </div>

    <div class="ft-zoneconfig-section-content" id="ft-zoneconfig-consequences-section">

      <div class="ft-zoneconfig-field">
        <label>Consequences</label>
        <textarea name="consequences" rows="6">{{consequencesText}}</textarea>
      </div>

    </div>

  </section>

  <footer class="ft-zoneconfig-footer">

    <button type="submit">
      <i class="fas fa-save"></i> Save
    </button>

    <button type="button" class="ft-zoneconfig-delete">
      <i class="fas fa-trash"></i> Delete Zone
    </button>

  </footer>

</form>